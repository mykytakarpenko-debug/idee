# ---------------------------------------------------------------------------
# Agenda — variabili d'ambiente di esempio
# Copia in `.env.local`. Non inserire MAI chiavi, password o dati reali qui:
# il file è versionato e pubblico.
# ---------------------------------------------------------------------------

# URL pubblico del sito (metadata, link assoluti, sitemap, codice del widget).
# Su Vercel, se vuota, viene usato il dominio di produzione.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Modalità demo: prenotazioni simulate, salvate solo nel browser.
NEXT_PUBLIC_DEMO_MODE=true

# Indicizzazione della pagina pubblica. Il pannello /gestione non viene mai indicizzato.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Origini che possono incorporare il widget /widget in un iframe (separate da spazi),
# es. "https://www.miosito.it". Vuota = solo lo stesso dominio. Lato server.
WIDGET_FRAME_ANCESTORS=

# ---------------------------------------------------------------------------
# Integrazioni future (vedi docs/architettura.md). Valori reali solo su Vercel.
# ---------------------------------------------------------------------------
# DATABASE_URL=
# AUTH_SECRET=
# RESEND_API_KEY=
# GOOGLE_CALENDAR_CLIENT_SECRET=
