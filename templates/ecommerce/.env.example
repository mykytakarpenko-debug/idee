# ---------------------------------------------------------------------------
# Bottega — variabili d'ambiente di esempio
# Copia in `.env.local`. Non inserire MAI chiavi, password o dati reali qui:
# il file è versionato e pubblico.
# ---------------------------------------------------------------------------

# URL pubblico del negozio (metadata, link assoluti, sitemap, dati strutturati).
# Su Vercel, se vuota, viene usato il dominio di produzione.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Modalità demo: ordini simulati e salvati solo nel browser, credenziali precompilate.
NEXT_PUBLIC_DEMO_MODE=true

# Indicizzazione del negozio. Carrello, checkout, ordini, area personale e pannello mai.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ---------------------------------------------------------------------------
# Integrazioni future (vedi docs/architettura.md). Valori reali solo su Vercel.
# ---------------------------------------------------------------------------
# DATABASE_URL=
# AUTH_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
