# ---------------------------------------------------------------------------
# Nucleo — variabili d'ambiente di esempio
# Copia questo file in `.env.local` e modifica i valori.
# Non inserire MAI chiavi, password o dati reali in questo file:
# è versionato e pubblico.
# ---------------------------------------------------------------------------

# URL pubblico dell'app (metadata, link assoluti, Open Graph).
# Su Vercel, se vuota, viene usato automaticamente il dominio di produzione.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Modalità demo: dati fittizi generati e salvati solo nel browser dell'utente.
# Mostra il banner informativo e il pulsante "Ripristina dati demo".
NEXT_PUBLIC_DEMO_MODE=true

# Indicizzazione sui motori di ricerca. Un gestionale privato NON va indicizzato.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ---------------------------------------------------------------------------
# Integrazioni future (vedi docs/architettura.md). Lasciare vuote finché
# non vengono configurate; i valori reali vanno solo su Vercel → Settings →
# Environment Variables, mai nel repository.
# ---------------------------------------------------------------------------
# DATABASE_URL=
# AUTH_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
