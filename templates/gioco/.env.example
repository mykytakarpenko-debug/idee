# ---------------------------------------------------------------------------
# Arena — variabili d'ambiente di esempio
# Copia in `.env.local`. Non inserire MAI chiavi, password o dati reali qui:
# il file è versionato e pubblico.
# ---------------------------------------------------------------------------

# URL pubblico del sito (metadata e link assoluti).
# Su Vercel, se vuota, viene usato il dominio di produzione.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Modalità demo: crediti senza valore salvati nel browser, credenziali
# precompilate, pannello operatore aperto. In produzione: false.
NEXT_PUBLIC_DEMO_MODE=true

# Indicizzazione delle pagine pubbliche. Conto, accesso, registrazione e
# pannello operatore mai.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ---------------------------------------------------------------------------
# Integrazioni future (vedi docs/architettura.md). Valori reali solo su Vercel.
# Un sito di gioco con vincita in denaro richiede la concessione ADM.
# ---------------------------------------------------------------------------
# DATABASE_URL=
# AUTH_SECRET=
# ADM_GATEWAY_URL=
# KYC_PROVIDER_API_KEY=
# PAYMENT_PROVIDER_SECRET_KEY=
# RNG_SERVICE_URL=
