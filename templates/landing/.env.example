# ---------------------------------------------------------------------------
# Vetrina — variabili d'ambiente di esempio
# Copia in `.env.local`. Non inserire MAI chiavi, password o dati reali qui:
# il file è versionato e pubblico.
# ---------------------------------------------------------------------------

# URL pubblico del sito (canonical, sitemap, Open Graph, dati strutturati).
# Su Vercel, se vuota, viene usato il dominio di produzione.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Modalità demo: mostra l'avviso che il modulo contatti non invia nulla.
NEXT_PUBLIC_DEMO_MODE=true

# Indicizzazione: true in produzione, false negli ambienti di prova.
NEXT_PUBLIC_ALLOW_INDEXING=true

# ---------------------------------------------------------------------------
# Integrazioni (vedi docs/architettura.md). Valori reali solo su Vercel.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# NEXT_PUBLIC_ANALYTICS_DOMAIN=
