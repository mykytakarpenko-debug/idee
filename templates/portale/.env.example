# ---------------------------------------------------------------------------
# Portale — variabili d'ambiente di esempio
# Copia in `.env.local`. Non inserire MAI chiavi, password o dati reali qui:
# il file è versionato e pubblico.
# ---------------------------------------------------------------------------

# URL pubblico del portale (metadata e link assoluti).
# Su Vercel, se vuota, viene usato il dominio di produzione.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Modalità demo: dati inventati salvati solo nel browser, account demo e codice
# di verifica mostrati nella pagina di accesso. In produzione: false.
NEXT_PUBLIC_DEMO_MODE=true

# Il portale non viene mai indicizzato (robots.txt e meta robots bloccano tutto).

# ---------------------------------------------------------------------------
# Integrazioni future (vedi docs/architettura.md). Valori reali solo su Vercel.
# ---------------------------------------------------------------------------
# DATABASE_URL=
# AUTH_SECRET=
# AUTH_ISSUER=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# RESEND_API_KEY=
