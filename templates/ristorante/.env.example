# ---------------------------------------------------------------------------
# Tavola — variabili d'ambiente di esempio
# Copia in `.env.local`. Non inserire MAI chiavi, password o dati reali qui:
# il file è versionato e pubblico.
# ---------------------------------------------------------------------------

# URL pubblico del sito (metadata, link assoluti, sitemap).
# Su Vercel, se vuota, viene usato il dominio di produzione.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Modalità demo: prenotazioni e ordini simulati, salvati solo nel browser.
NEXT_PUBLIC_DEMO_MODE=true

# Indicizzazione del sito pubblico. Il pannello /gestione non viene mai indicizzato.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ---------------------------------------------------------------------------
# Integrazioni future (vedi docs/architettura.md). Valori reali solo su Vercel.
# ---------------------------------------------------------------------------
# DATABASE_URL=
# AUTH_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=
